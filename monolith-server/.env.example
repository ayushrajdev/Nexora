NODE_ENV=development
PORT=3000
FRONT_END_URL=http://localhost:5173
LOG_LEVEL=info

# MongoDB Connection
# DB_CONNECTION_STRING=mongodb://localhost:27017/devtinder_monolith
DB_CONNECTION_STRING=mongodb+srv://ayushrajdev10_db_user:IktfLhKzT4IrAVt9@cluster0.c6h9jgi.mongodb.net/devtinder_monolith

# Session & Redis Configuration ('redis' | 'memory')
SESSION_STORE_TYPE=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_TTL=86400

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/github/callback

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Notification ('console' | 'ses')
NOTIFICATION_PROVIDER=console
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
SES_FROM_EMAIL=noreply@devtinder.in
